<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head') %>
    <style>
        .copy-key { font-family: monospace; font-size: 14px; }
        .copy-kind { color: #666; font-weight: normal; font-size: 13px; }
        .copy-vars { color: #888; font-size: 13px; margin-bottom: 12px; }
        .copy-desc { color: #666; margin-bottom: 8px; }
        .form-textarea {
            width: 100%;
            padding: 10px 12px;
            border: 2px solid #e0e0e0;
            border-radius: 6px;
            font-size: 14px;
            font-family: inherit;
            resize: vertical;
        }
        .form-textarea:focus {
            border-color: var(--color-accent);
            outline: none;
        }
        .success-banner {
            background: #d4edda;
            color: #155724;
            padding: 12px 16px;
            border-radius: 6px;
            margin-bottom: 20px;
        }
        .error-banner {
            background: #f8d7da;
            color: #721c24;
            padding: 12px 16px;
            border-radius: 6px;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <%- include('partials/sidebar') %>

    <main class="main-content" id="main-content">
        <%- include('partials/topbar') %>

        <div class="container">
            <% if (success) { %>
                <div class="success-banner">✅ Copy berhasil disimpan. Bot akan memuat ulang dalam ~10 detik.</div>
            <% } %>
            <% if (typeof req !== 'undefined' && req.query && req.query.error === 'empty') { %>
                <div class="error-banner">⚠️ Body tidak boleh kosong.</div>
            <% } %>

            <div class="card" style="margin-bottom: 20px;">
                <div class="card-header">
                    <h2 class="card-title">Tentang Bot Copy</h2>
                </div>
                <div class="card-body">
                    <p style="color: #666; margin: 0;">
                        Edit teks layar (<code>screen</code>), pesan (<code>msg</code>), error (<code>err</code>), dan label tombol (<code>btn</code>).
                        Gunakan <code>{{variabel}}</code> untuk bagian dinamis. Perubahan aktif ~10 detik tanpa restart bot.
                    </p>
                </div>
            </div>

            <p style="margin-bottom: 16px;">
                <% const kinds = ['all','screen','msg','err','btn']; %>
                <% kinds.forEach(k => { %>
                    <a class="btn <%= filterKind === k ? 'btn-primary' : 'btn-secondary' %>"
                       href="/settings/bot-copy<%= k === 'all' ? '' : '?kind=' + k %>"
                       style="margin-right: 6px;"><%= k %></a>
                <% }) %>
            </p>

            <% rows.forEach(row => { %>
                <div class="card" style="margin-bottom: 16px;">
                    <div class="card-header">
                        <h2 class="card-title">
                            <code class="copy-key"><%= row.key %></code>
                            <span class="copy-kind">(<%= row.kind %>)</span>
                        </h2>
                    </div>
                    <div class="card-body">
                        <% if (row.description) { %>
                            <p class="copy-desc"><%= row.description %></p>
                        <% } %>
                        <p class="copy-vars">
                            Variables:
                            <% const vars = Array.isArray(row.variables) ? row.variables : []; %>
                            <%= vars.length ? vars.join(', ') : '—' %>
                        </p>
                        <form method="POST" action="/settings/bot-copy/<%= encodeURIComponent(row.key) %>">
                            <textarea name="body" class="form-textarea" rows="8" required><%= row.body %></textarea>
                            <button type="submit" class="btn btn-primary" style="margin-top: 10px;">Simpan</button>
                        </form>
                    </div>
                </div>
            <% }) %>
        </div>
    </main>
    <%- include('partials/mobile-tabs') %>
</body>
</html>

<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head') %>
    <style>
        .catalog-summary {
            display: flex;
            gap: 16px;
            flex-wrap: wrap;
            margin-bottom: 20px;
        }
        .catalog-summary .stat-card {
            flex: 1;
            min-width: 140px;
        }
        .table-card .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }
        .catalog-meta {
            color: var(--color-muted);
            font-size: 14px;
        }
        .search-card {
            margin-bottom: 20px;
        }
        .table-card {
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    
    <%- include('partials/sidebar') %>
    
    <main class="main-content" id="main-content">
        <%- include('partials/topbar') %>
        
        <div class="container">
            <%
                const totalProducts = products.length;
                const totalVariants = products.reduce((sum, p) => sum + (p.variant_count || 0), 0);
                const totalStock = products.reduce((sum, p) => sum + (p.total_stock || 0), 0);
                const activeProducts = products.filter(p => p.is_active !== false).length;
            %>
            <div class="catalog-summary">
                <div class="stat-card">
                    <div class="stat-icon">📦</div>
                    <div class="stat-info">
                        <h3>Total Produk</h3>
                        <p class="stat-value"><%= totalProducts %></p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">🏷️</div>
                    <div class="stat-info">
                        <h3>Total Varian</h3>
                        <p class="stat-value"><%= totalVariants %></p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">📊</div>
                    <div class="stat-info">
                        <h3>Total Stok</h3>
                        <p class="stat-value" style="color: var(--color-accent);"><%= totalStock %></p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">✅</div>
                    <div class="stat-info">
                        <h3>Aktif</h3>
                        <p class="stat-value" style="color: var(--color-success);"><%= activeProducts %></p>
                    </div>
                </div>
            </div>

            <div class="card search-card">
                <div class="card-body">
                    <div class="search-container">
                        <span class="search-icon">🔍</span>
                        <input type="text" id="searchInput" class="search-input" placeholder="Cari produk (nama, kategori)...">
                    </div>
                </div>
            </div>
            
            <div class="card table-card">
                <div class="card-header">
                    <h2 class="card-title">Daftar Produk</h2>
                    <span class="catalog-meta"><%= totalVariants %> varian · <%= totalStock %> stok total</span>
                </div>
                <div class="card-body">
                    <div class="table-wrapper">
                        <table>
                            <thead>
                                <tr>
                                    <th>Nama</th>
                                    <th>Kategori</th>
                                    <th># Varian</th>
                                    <th>Total Stok</th>
                                    <th>Status</th>
                                    <th>Aksi</th>
                                </tr>
                            </thead>
                            <tbody id="productsTableBody">
                                <% if (products.length === 0) { %>
                                    <tr>
                                        <td colspan="6">
                                            <div class="empty-state">
                                                <div class="empty-state-icon">📦</div>
                                                <div class="empty-state-title">Belum ada produk</div>
                                                <div class="empty-state-description">Mulai dengan menambahkan produk pertama Anda</div>
                                                <a href="/produk/tambah" class="empty-state-action">➕ Tambah Produk</a>
                                            </div>
                                        </td>
                                    </tr>
                                <% } else { %>
                                    <% products.forEach(p => { %>
                                        <tr>
                                            <td><strong><%= p.nama %></strong></td>
                                            <td><span class="badge badge-success"><%= p.kategori || 'umum' %></span></td>
                                            <td><%= p.variant_count || 0 %></td>
                                            <td>
                                                <% 
                                                    const stokCount = p.total_stock !== undefined ? p.total_stock : 0;
                                                    const badgeClass = stokCount === 0 ? 'badge-danger' : (stokCount < 10 ? 'badge-warning' : 'badge-success');
                                                %>
                                                <span class="badge <%= badgeClass %>"><%= stokCount %></span>
                                            </td>
                                            <td>
                                                <% if (p.is_active !== false) { %>
                                                    <span class="badge badge-success">Aktif</span>
                                                <% } else { %>
                                                    <span class="badge badge-danger">Nonaktif</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <div class="table-actions">
                                                    <a href="/produk/<%= p.id %>" class="btn-icon" title="Detail">✏️</a>
                                                    <a href="/produk/hapus/<%= p.id %>" class="btn-icon" title="Hapus">🗑️</a>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <%- include('partials/mobile-tabs') %>
    
    <div class="quick-actions">
        <button class="quick-action-btn" onclick="window.scrollTo({top: 0, behavior: 'smooth'})" aria-label="Scroll to top" title="Scroll to top">
            ↑
        </button>
    </div>
    
    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('collapsed');
            sidebar.classList.toggle('open');
        }
        
        document.addEventListener('click', (e) => {
            const sidebar = document.getElementById('sidebar');
            const toggleBtn = document.querySelector('.sidebar-toggle');
            
            if (window.innerWidth <= 768 && 
                sidebar.classList.contains('open') && 
                !sidebar.contains(e.target) && 
                !toggleBtn.contains(e.target)) {
                sidebar.classList.remove('open');
            }
        });
        
        window.addEventListener('resize', () => {
            const sidebar = document.getElementById('sidebar');
            if (window.innerWidth > 768) {
                sidebar.classList.remove('open');
            }
        });
        
        document.addEventListener('DOMContentLoaded', () => {
            const searchInput = document.getElementById('searchInput');
            const tableBody = document.getElementById('productsTableBody');
            
            if (searchInput && tableBody) {
                SearchHelper.init(searchInput, tableBody, [0, 1]);
            }
            
            const urlParams = new URLSearchParams(window.location.search);
            const success = urlParams.get('success');
            const error = urlParams.get('error');
            
            if (success) {
                const messages = {
                    'tambah': 'Produk berhasil ditambahkan!',
                    'edit': 'Produk berhasil diupdate!',
                    'hapus': 'Produk berhasil dihapus!'
                };
                toast.success(messages[success] || 'Operasi berhasil!', 'Berhasil');
            }
            if (error) {
                const messages = {
                    'notfound': 'Produk tidak ditemukan!',
                    'hapus': 'Gagal menghapus produk!'
                };
                toast.error(messages[error] || 'Terjadi kesalahan!', 'Error');
            }
        });
    </script>
    
    <script src="/js/notifications.js"></script>
</body>
</html>

<%
    breadcrumbs = [
        { label: 'Home', href: '/' },
        { label: 'Catalog', href: '/produk' },
        { label: 'Products' }
    ];
%>
<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head') %>
    <style>
        .table-card .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }
        .catalog-meta {
            color: var(--color-muted);
            font-size: 14px;
        }
        .table-card {
            margin-bottom: 20px;
        }
        .metric-tile .value.accent { color: var(--color-accent); }
        .metric-tile .value.success { color: var(--color-success); }
        .toolbar .search-container {
            flex: 1;
            min-width: 200px;
            margin: 0;
        }
        .toolbar .search-input {
            width: 100%;
        }
    </style>
</head>
<body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    
    <%- include('partials/sidebar') %>
    
    <main class="main-content" id="main-content">
        <%- include('partials/topbar') %>
        
        <div class="container">
            <%- include('partials/page-header', { breadcrumbs: breadcrumbs, pageHeaderActions: '' }) %>

            <%
                const totalProducts = products.length;
                const totalVariants = products.reduce((sum, p) => sum + (p.variant_count || 0), 0);
                const totalStock = products.reduce((sum, p) => sum + (p.total_stock || 0), 0);
                const activeProducts = products.filter(p => p.is_active !== false).length;
            %>
            <div class="metric-strip">
                <div class="metric-tile">
                    <div class="label">Total Produk</div>
                    <div class="value"><%= totalProducts %></div>
                </div>
                <div class="metric-tile">
                    <div class="label">Total Varian</div>
                    <div class="value"><%= totalVariants %></div>
                </div>
                <div class="metric-tile">
                    <div class="label">Total Stok</div>
                    <div class="value accent"><%= totalStock %></div>
                </div>
                <div class="metric-tile">
                    <div class="label">Aktif</div>
                    <div class="value success"><%= activeProducts %></div>
                </div>
            </div>

            <div class="toolbar">
                <div class="search-container">
                    <span class="search-icon"><svg class="icon" aria-hidden="true"><use href="#i-search"></use></svg></span>
                    <input type="text" id="searchInput" class="search-input" placeholder="Cari produk (nama, kategori)...">
                </div>
                <div class="toolbar-spacer"></div>
            </div>
            
            <div class="card table-card">
                <div class="card-header">
                    <h2 class="card-title">Daftar Produk</h2>
                    <span class="catalog-meta"><%= totalVariants %> varian · <%= totalStock %> stok total</span>
                </div>
                <div class="card-body">
                    <div class="table-wrapper">
                        <table>
                            <thead>
                                <tr>
                                    <th>Nama</th>
                                    <th>Kategori</th>
                                    <th># Varian</th>
                                    <th>Total Stok</th>
                                    <th>Status</th>
                                    <th>Aksi</th>
                                </tr>
                            </thead>
                            <tbody id="productsTableBody">
                                <% if (products.length === 0) { %>
                                    <tr>
                                        <td colspan="6">
                                            <div class="empty-state">
                                                <div class="empty-state-icon">📦</div>
                                                <div class="empty-state-title">Belum ada produk</div>
                                                <div class="empty-state-description">Mulai dengan menambahkan produk pertama Anda</div>
                                                <a href="/produk/tambah" class="empty-state-action">➕ Tambah Produk</a>
                                            </div>
                                        </td>
                                    </tr>
                                <% } else { %>
                                    <% products.forEach(p => { %>
                                        <tr>
                                            <td><strong><%= p.nama %></strong></td>
                                            <td><span class="badge badge-success"><%= p.kategori || 'umum' %></span></td>
                                            <td><%= p.variant_count || 0 %></td>
                                            <td>
                                                <% 
                                                    const stokCount = p.total_stock !== undefined ? p.total_stock : 0;
                                                    const badgeClass = stokCount === 0 ? 'badge-danger' : (stokCount < 10 ? 'badge-warning' : 'badge-success');
                                                %>
                                                <span class="badge <%= badgeClass %>"><%= stokCount %></span>
                                            </td>
                                            <td>
                                                <% if (p.is_active !== false) { %>
                                                    <span class="badge badge-success">Aktif</span>
                                                <% } else { %>
                                                    <span class="badge badge-danger">Nonaktif</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <div class="table-actions">
                                                    <a href="/produk/<%= p.id %>" class="btn-icon" title="Detail"><svg class="icon" aria-hidden="true"><use href="#i-pencil"></use></svg></a>
                                                    <a href="/produk/hapus/<%= p.id %>" class="btn-icon" title="Hapus"><svg class="icon" aria-hidden="true"><use href="#i-trash"></use></svg></a>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <%- include('partials/mobile-tabs') %>
    
    <div class="quick-actions">
        <button class="quick-action-btn" onclick="window.scrollTo({top: 0, behavior: 'smooth'})" aria-label="Scroll to top" title="Scroll to top">
            ↑
        </button>
    </div>
    
    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('collapsed');
            sidebar.classList.toggle('open');
        }
        
        document.addEventListener('click', (e) => {
            const sidebar = document.getElementById('sidebar');
            const toggleBtn = document.querySelector('.sidebar-toggle');
            
            if (window.innerWidth <= 768 && 
                sidebar.classList.contains('open') && 
                !sidebar.contains(e.target) && 
                !toggleBtn.contains(e.target)) {
                sidebar.classList.remove('open');
            }
        });
        
        window.addEventListener('resize', () => {
            const sidebar = document.getElementById('sidebar');
            if (window.innerWidth > 768) {
                sidebar.classList.remove('open');
            }
        });
        
        document.addEventListener('DOMContentLoaded', () => {
            const searchInput = document.getElementById('searchInput');
            const tableBody = document.getElementById('productsTableBody');
            
            if (searchInput && tableBody) {
                SearchHelper.init(searchInput, tableBody, [0, 1]);
            }
            
            const urlParams = new URLSearchParams(window.location.search);
            const success = urlParams.get('success');
            const error = urlParams.get('error');
            
            if (success) {
                const messages = {
                    'tambah': 'Produk berhasil ditambahkan!',
                    'edit': 'Produk berhasil diupdate!',
                    'hapus': 'Produk berhasil dihapus!'
                };
                toast.success(messages[success] || 'Operasi berhasil!', 'Berhasil');
            }
            if (error) {
                const messages = {
                    'notfound': 'Produk tidak ditemukan!',
                    'hapus': 'Gagal menghapus produk!'
                };
                toast.error(messages[error] || 'Terjadi kesalahan!', 'Error');
            }
        });
    </script>
    
</body>
</html>

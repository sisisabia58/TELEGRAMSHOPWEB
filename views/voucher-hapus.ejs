<%
    const currentPage = 'voucher';
    const pageTitle = '🗑️ Hapus Voucher';
%>
<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head') %>
    <style>
        .confirm-container {
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            max-width: 600px;
            margin: 0 auto;
        }
        .warning-box {
            background: #fff3cd;
            border: 2px solid #ffc107;
            border-radius: 8px;
            padding: 20px;
            margin: 20px 0;
        }
        .warning-box h3 {
            color: #856404;
            margin-bottom: 10px;
        }
        .voucher-info {
            background: #f8f9fa;
            padding: 15px;
            border-radius: 8px;
            margin: 15px 0;
        }
        .voucher-info p {
            margin: 5px 0;
        }
        .form-actions {
            display: flex;
            gap: 10px;
            margin-top: 30px;
        }
        .btn-delete {
            padding: 12px 24px;
            background: #dc3545;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
        }
        .btn-cancel {
            padding: 12px 24px;
            background: #6c757d;
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <%- include('partials/sidebar') %>
    <main class="main-content" id="main-content">
        <%
            const topbarExtra = `<a href="/voucher" class="btn-top">← Voucher</a>`
        %>
        <%- include('partials/topbar') %>
        <div class="container">
            <div class="confirm-container">
            <div class="warning-box">
            <h3>⚠️ Peringatan!</h3>
            <p>Anda akan menghapus voucher ini. Tindakan ini tidak dapat dibatalkan!</p>
            </div>

            <div class="voucher-info">
            <h3>Informasi Voucher:</h3>
            <p><strong>Kode:</strong> <code><%= voucher.kode %></code></p>
            <p><strong>Potongan:</strong> <%= formatrupiah(voucher.potongan) %></p>
            <p><strong>Limit:</strong> <%= voucher.limit %></p>
            <p><strong>Penggunaan:</strong> <%= Array.isArray(voucher.user) ? voucher.user.length : 0 %></p>
            <p><strong>Created:</strong> <%= new Date(voucher.created_at).toLocaleDateString('id-ID') %></p>
            </div>

            <form method="POST" action="/voucher/hapus/<%= voucher.id %>">
            <div class="form-actions">
            <button type="submit" class="btn-delete">
            🗑️ Ya, Hapus Voucher
            </button>
            <a href="/voucher" class="btn-cancel">❌ Batal</a>
            </div>
            </form>
            </div>
        </div>
    </main>
    <%- include('partials/mobile-tabs') %>
</body>
</html>


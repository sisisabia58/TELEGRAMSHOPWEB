<%
    const model = overview || {};
    const pendingDeposits = model.pendingDeposits || [];
    const outOfStock = model.outOfStock || [];
    const lowStock = model.lowStock || [];
    const recentTxns = model.recentTxns || [];
    breadcrumbs = [
        { label: 'Home', href: '/' },
        { label: 'Overview' }
    ];
    const dashboardHeaderActions = `
        <a href="/deposit" class="btn btn-primary">Cek Deposit</a>
        <a href="/stok" class="btn btn-warning">Cek Stok</a>
        <a href="/settings/bot-flow" class="btn btn-secondary">Bot Flow</a>
    `;
%>
<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head') %>
    <style>
        .overview-subtitle {
            margin: 0 0 20px;
            color: var(--color-muted);
        }
        .triage-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 16px;
            margin-bottom: 20px;
        }
        .triage-card {
            display: flex;
            flex-direction: column;
            gap: 14px;
            min-height: 160px;
        }
        .triage-card .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
        }
        .triage-copy {
            color: var(--color-muted);
            margin: 0;
        }
        .triage-list {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .triage-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            padding: 10px 0;
            border-bottom: 1px solid var(--color-border);
        }
        .triage-row:last-child {
            border-bottom: none;
        }
        .triage-main {
            min-width: 0;
        }
        .triage-main strong,
        .triage-main span {
            display: block;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .triage-main span,
        .triage-meta {
            color: var(--color-muted);
            font-size: 13px;
        }
        .notice-card {
            border-left: 4px solid var(--color-warning);
            margin-bottom: 20px;
        }
        .overview-section {
            margin-bottom: 20px;
        }
        .overview-section .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }
        .overview-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }
        .metric-tile .value.warning { color: var(--color-warning); }
        .metric-tile .value.danger { color: var(--color-danger); }
        .metric-tile .value.success { color: var(--color-success); }
        .metric-tile .sub {
            font-size: 12px;
            color: var(--color-muted);
            margin-top: 4px;
        }
        @media (max-width: 768px) {
            .page-header-actions .btn,
            .triage-card .btn,
            .overview-actions .btn {
                width: 100%;
                text-align: center;
            }
        }
    </style>
</head>
<body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <%- include('partials/sidebar') %>

    <main class="main-content" id="main-content">
        <%- include('partials/topbar') %>

        <div class="container">
            <%- include('partials/page-header', { breadcrumbs: breadcrumbs, pageHeaderActions: dashboardHeaderActions }) %>
            <p class="overview-subtitle">Prioritas operasional hari ini untuk deposit, stok, harga, transaksi, dan alur bot.</p>

            <% if (model.draftNotice) { %>
                <div class="card notice-card">
                    <div class="card-body">
                        <span class="badge badge-warning">Draft Flow</span>
                        <p style="margin: 10px 0 16px;"><%= model.draftNotice %></p>
                        <a href="/settings/bot-flow" class="btn btn-warning">Review Bot Flow</a>
                    </div>
                </div>
            <% } %>

            <div class="metric-strip">
                <div class="metric-tile">
                    <div class="label">Deposit Pending</div>
                    <div class="value <%= pendingDeposits.length ? 'warning' : 'success' %>"><%= pendingDeposits.length %></div>
                    <div class="sub"><%= pendingDeposits.length ? 'Butuh cek' : 'Aman' %></div>
                </div>
                <div class="metric-tile">
                    <div class="label">Stok Habis</div>
                    <div class="value <%= outOfStock.length ? 'danger' : 'success' %>"><%= outOfStock.length %></div>
                    <div class="sub"><%= outOfStock.length ? 'Varian tanpa stok' : 'Aman' %></div>
                </div>
                <div class="metric-tile">
                    <div class="label">Stok Rendah</div>
                    <div class="value <%= lowStock.length ? 'warning' : 'success' %>"><%= lowStock.length %></div>
                    <div class="sub"><%= lowStock.length ? 'Perlu isi' : 'Aman' %></div>
                </div>
                <div class="metric-tile">
                    <div class="label">Transaksi Hari Ini</div>
                    <div class="value"><%= model.todayTxnCount || 0 %></div>
                    <div class="sub">Revenue: <%= formatrupiah(model.todayRevenue || 0) %></div>
                </div>
            </div>

            <div class="triage-grid">
                <div class="card triage-card">
                    <div class="card-header">
                        <h2 class="card-title">Deposit Pending</h2>
                        <span class="badge <%= pendingDeposits.length ? 'badge-warning' : 'badge-success' %>">
                            <%= pendingDeposits.length ? 'Butuh cek' : 'Aman' %>
                        </span>
                    </div>
                    <div class="card-body">
                        <p class="triage-copy">Deposit menunggu approval atau rekonsiliasi.</p>
                        <% if (pendingDeposits.length) { %>
                            <ul class="triage-list">
                                <% pendingDeposits.slice(0, 3).forEach((deposit) => { %>
                                    <li class="triage-row">
                                        <div class="triage-main">
                                            <strong><%= deposit.kode_deposit || deposit.id %></strong>
                                            <span>User <%= deposit.user_id %> - <%= formatrupiah(deposit.jumlah || deposit.total || 0) %></span>
                                        </div>
                                        <a href="/deposit/<%= deposit.id %>" class="btn-action btn-edit">Detail</a>
                                    </li>
                                <% }) %>
                            </ul>
                        <% } %>
                        <a href="/deposit?status=pending" class="btn btn-primary" style="margin-top: 14px;">Buka Deposit</a>
                    </div>
                </div>

                <div class="card triage-card">
                    <div class="card-header">
                        <h2 class="card-title">Stok Habis</h2>
                        <span class="badge <%= outOfStock.length ? 'badge-danger' : 'badge-success' %>">
                            <%= outOfStock.length ? 'Habis' : 'Aman' %>
                        </span>
                    </div>
                    <div class="card-body">
                        <p class="triage-copy">Varian aktif yang tidak punya stok tersedia.</p>
                        <% if (outOfStock.length) { %>
                            <ul class="triage-list">
                                <% outOfStock.slice(0, 3).forEach((variant) => { %>
                                    <li class="triage-row">
                                        <div class="triage-main">
                                            <strong><%= variant.produk_nama || 'Produk' %></strong>
                                            <span><%= variant.label %> (<%= variant.kode %>)</span>
                                        </div>
                                        <span class="badge badge-danger">0</span>
                                    </li>
                                <% }) %>
                            </ul>
                        <% } %>
                        <a href="/stok" class="btn btn-warning" style="margin-top: 14px;">Buka Stok</a>
                    </div>
                </div>

                <div class="card triage-card">
                    <div class="card-header">
                        <h2 class="card-title">Stok Rendah</h2>
                        <span class="badge <%= lowStock.length ? 'badge-warning' : 'badge-success' %>">
                            <%= lowStock.length ? 'Perlu isi' : 'Aman' %>
                        </span>
                    </div>
                    <div class="card-body">
                        <p class="triage-copy">Varian aktif di bawah atau sama dengan threshold.</p>
                        <% if (lowStock.length) { %>
                            <ul class="triage-list">
                                <% lowStock.slice(0, 3).forEach((variant) => { %>
                                    <li class="triage-row">
                                        <div class="triage-main">
                                            <strong><%= variant.produk_nama || 'Produk' %></strong>
                                            <span><%= variant.label %> (<%= variant.kode %>)</span>
                                        </div>
                                        <span class="triage-meta"><%= variant.stok_count %>/<%= variant.threshold == null ? 5 : variant.threshold %></span>
                                    </li>
                                <% }) %>
                            </ul>
                        <% } %>
                        <a href="/stok" class="btn btn-secondary" style="margin-top: 14px;">Buka Stok</a>
                    </div>
                </div>

                <div class="card triage-card">
                    <div class="card-header">
                        <h2 class="card-title">Transaksi Hari Ini</h2>
                        <span class="badge badge-info">WIB</span>
                    </div>
                    <div class="card-body">
                        <p class="triage-copy">Revenue hari ini: <strong><%= formatrupiah(model.todayRevenue || 0) %></strong></p>
                        <a href="/transaksi" class="btn btn-primary" style="margin-top: 14px;">Buka Transaksi</a>
                    </div>
                </div>
            </div>

            <div class="card overview-section">
                <div class="card-header">
                    <h2 class="card-title">Transaksi Terbaru</h2>
                    <a href="/transaksi" class="btn btn-primary">Lihat Semua</a>
                </div>
                <div class="card-body">
                    <div class="table-wrapper">
                        <table>
                            <thead>
                                <tr>
                                    <th>Tanggal</th>
                                    <th>Produk</th>
                                    <th>Jumlah</th>
                                    <th>Harga</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (recentTxns.length === 0) { %>
                                    <tr>
                                        <td colspan="4">
                                            <div class="empty-state">
                                                <div class="empty-state-icon">📭</div>
                                                <div class="empty-state-title">Belum ada transaksi</div>
                                                <div class="empty-state-description">Transaksi terbaru akan muncul di sini.</div>
                                            </div>
                                        </td>
                                    </tr>
                                <% } else { %>
                                    <% recentTxns.forEach((trx) => { %>
                                        <tr>
                                            <td><%= formatTanggal(trx.tanggal) %></td>
                                            <td><%= trx.nama %></td>
                                            <td><%= trx.jumlah %></td>
                                            <td><%= formatrupiah(trx.harga) %></td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card overview-section">
                <div class="card-header">
                    <h2 class="card-title">Aksi Cepat</h2>
                </div>
                <div class="card-body">
                    <div class="overview-actions">
                        <a href="/deposit" class="btn btn-primary">Deposit</a>
                        <a href="/stok" class="btn btn-warning">Stok</a>
                        <a href="/pricing" class="btn btn-secondary">Pricing</a>
                        <a href="/transaksi" class="btn btn-primary">Transaksi</a>
                        <a href="/settings/bot-flow" class="btn btn-secondary">Bot Flow</a>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <%- include('partials/mobile-tabs') %>

    <div class="quick-actions">
        <button class="quick-action-btn" onclick="window.scrollTo({top: 0, behavior: 'smooth'})" aria-label="Scroll to top" title="Scroll to top">
            ↑
        </button>
    </div>

</body>
</html>

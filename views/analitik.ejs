<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head') %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .analitik-product-grid {
            margin-bottom: 20px;
        }
        .chart-subtitle {
            color: var(--color-muted);
            font-size: 13px;
            margin-top: 4px;
        }
    </style>
</head>
<body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    
    <%- include('partials/sidebar') %>
    
    <main class="main-content" id="main-content">
        <%- include('partials/topbar') %>
        
        <div class="container">
            <!-- Period Selector -->
            <div class="card" style="margin-bottom: 20px;">
                <div class="card-body">
                    <div class="filter-container">
                        <a href="?period=daily" class="filter-chip <%= currentPeriod === 'daily' ? 'active' : '' %>">Harian</a>
                        <a href="?period=weekly" class="filter-chip <%= currentPeriod === 'weekly' ? 'active' : '' %>">Mingguan</a>
                        <a href="?period=monthly" class="filter-chip <%= currentPeriod === 'monthly' ? 'active' : '' %>">Bulanan</a>
                        <a href="?period=yearly" class="filter-chip <%= currentPeriod === 'yearly' ? 'active' : '' %>">Tahunan</a>
                    </div>
                </div>
            </div>
            
            <!-- Revenue Chart -->
            <div class="content-grid">
                <div class="card">
                    <div class="card-header">
                        <h2 class="card-title">📈 Revenue Trend</h2>
                    </div>
                    <div class="card-body">
                        <canvas id="revenueChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Product + Variant Charts -->
            <div class="content-grid analitik-product-grid">
                <div class="card">
                    <div class="card-header">
                        <h2 class="card-title">📊 Top Products</h2>
                        <p class="chart-subtitle">Agregat per produk (semua varian)</p>
                    </div>
                    <div class="card-body">
                        <canvas id="productsChart"></canvas>
                    </div>
                </div>
                
                <div class="card">
                    <div class="card-header">
                        <h2 class="card-title">🏷️ Top Variants</h2>
                        <p class="chart-subtitle">Per varian / kode</p>
                    </div>
                    <div class="card-body">
                        <canvas id="variantsChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <%- include('partials/mobile-tabs') %>
    
    <div class="quick-actions">
        <button class="quick-action-btn" onclick="window.scrollTo({top: 0, behavior: 'smooth'})" aria-label="Scroll to top" title="Scroll to top">
            ↑
        </button>
    </div>
    
    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('collapsed');
            sidebar.classList.toggle('open');
        }
        
        document.addEventListener('click', (e) => {
            const sidebar = document.getElementById('sidebar');
            const toggleBtn = document.querySelector('.sidebar-toggle');
            
            if (window.innerWidth <= 768 && 
                sidebar.classList.contains('open') && 
                !sidebar.contains(e.target) && 
                !toggleBtn.contains(e.target)) {
                sidebar.classList.remove('open');
            }
        });
        
        window.addEventListener('resize', () => {
            const sidebar = document.getElementById('sidebar');
            if (window.innerWidth > 768) {
                sidebar.classList.remove('open');
            }
        });
        
        const currentPeriod = '<%= currentPeriod %>';
        const accentColor = getComputedStyle(document.documentElement).getPropertyValue('--color-accent').trim() || '#0F766E';
        const accentMuted = 'rgba(15, 118, 110, 0.15)';
        const variantColor = getComputedStyle(document.documentElement).getPropertyValue('--color-success').trim() || '#059669';
        const variantMuted = 'rgba(5, 150, 105, 0.35)';

        function renderBarChart(canvasId, rows, labelField, emptyMessage, errorMessage, colors) {
            const canvas = document.getElementById(canvasId);
            const parent = canvas.parentElement;
            if (!rows || !rows.length) {
                parent.innerHTML = '<p class="text-muted">' + emptyMessage + '</p>';
                return;
            }
            const labels = rows.map((d) => (d[labelField] || d.kode || 'Item').substring(0, 24));
            const terjual = rows.map((d) => d.totalTerjual);
            new Chart(canvas, {
                type: 'bar',
                data: {
                    labels,
                    datasets: [{
                        label: 'Terjual',
                        data: terjual,
                        backgroundColor: colors.bg,
                        borderColor: colors.border,
                        borderWidth: 1
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { beginAtZero: true }
                    }
                }
            });
        }

        // Revenue chart
        fetch(`/api/analitik/sales?period=${currentPeriod}`)
            .then(res => res.json())
            .then(data => {
                if (data.success && data.data && data.data.length) {
                    const labels = data.data.map(d => d.period);
                    const revenues = data.data.map(d => d.revenue);
                    new Chart(document.getElementById('revenueChart'), {
                        type: 'line',
                        data: {
                            labels,
                            datasets: [{
                                label: 'Revenue (Rp)',
                                data: revenues,
                                borderColor: accentColor,
                                backgroundColor: accentMuted,
                                fill: true,
                                tension: 0.3
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: true,
                            plugins: { legend: { display: true } },
                            scales: {
                                y: { beginAtZero: true }
                            }
                        }
                    });
                } else {
                    document.getElementById('revenueChart').parentElement.innerHTML = '<p class="text-muted">Belum ada data penjualan untuk periode ini.</p>';
                }
            })
            .catch(() => {
                document.getElementById('revenueChart').parentElement.innerHTML = '<p class="text-danger">Gagal memuat data revenue.</p>';
            });

        // Product + variant charts
        fetch('/api/analitik/products?limit=10')
            .then(res => res.json())
            .then(data => {
                if (!data.success || !data.data) {
                    throw new Error('Invalid response');
                }
                const byProduct = Array.isArray(data.data.byProduct)
                    ? data.data.byProduct
                    : (Array.isArray(data.data) ? data.data : []);
                const byVariant = Array.isArray(data.data.byVariant) ? data.data.byVariant : [];

                renderBarChart(
                    'productsChart',
                    byProduct,
                    'nama',
                    'Belum ada data produk.',
                    'Gagal memuat data produk.',
                    { bg: accentMuted, border: accentColor }
                );
                renderBarChart(
                    'variantsChart',
                    byVariant,
                    'kode',
                    'Belum ada data varian.',
                    'Gagal memuat data varian.',
                    { bg: variantMuted, border: variantColor }
                );
            })
            .catch(() => {
                document.getElementById('productsChart').parentElement.innerHTML = '<p class="text-danger">Gagal memuat data produk.</p>';
                document.getElementById('variantsChart').parentElement.innerHTML = '<p class="text-danger">Gagal memuat data varian.</p>';
            });
    </script>
    
</body>
</html>

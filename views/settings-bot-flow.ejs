<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head') %>
    <link rel="stylesheet" href="/vendor/drawflow/drawflow.min.css">
    <link rel="stylesheet" href="/css/flow-builder.css">
</head>
<body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <%- include('partials/sidebar') %>
    <main class="main-content" id="main-content">
        <%- include('partials/topbar') %>

        <div class="flow-workspace">
            <header class="flow-topbar">
                <div class="flow-topbar-left">
                    <span class="flow-topbar-brand">Bot Flow</span>
                    <span class="flow-topbar-sep" aria-hidden="true">·</span>
                    <span id="flowName" class="flow-name" title="Flow name">Untitled flow</span>
                    <div class="flow-validation" id="flowValidation" hidden>
                        <button type="button" id="validationToggle" class="flow-validation-toggle" aria-expanded="false" aria-controls="validationList" title="Validation issues">
                            <span id="validationWarnBadge" class="flow-validation-badge is-warning" hidden>⚠0</span>
                            <span id="validationErrorBadge" class="flow-validation-badge is-error" hidden>⛔0</span>
                        </button>
                        <ul id="validationList" class="flow-validation-list hidden" role="list"></ul>
                    </div>
                </div>
                <div class="flow-topbar-center">
                    <span id="flowStatus" class="flow-status" aria-live="polite"></span>
                </div>
                <div class="flow-topbar-right">
                    <div class="history-controls">
                        <button type="button" id="btnUndo" class="flow-topbar-btn" title="Undo (Ctrl/Cmd+Z)" disabled>Undo</button>
                        <button type="button" id="btnRedo" class="flow-topbar-btn" title="Redo (Ctrl/Cmd+Shift+Z or Ctrl+Y)" disabled>Redo</button>
                    </div>
                    <button type="button" id="btnPreview" class="flow-topbar-btn">Preview</button>
                    <div class="flow-dropdown" id="saveDropdown">
                        <button type="button" id="btnSaveMenu" class="flow-topbar-btn flow-topbar-btn-primary" aria-expanded="false" aria-controls="flowSaveMenu">
                            Save <span aria-hidden="true">▾</span>
                        </button>
                        <div id="flowSaveMenu" class="flow-dropdown-menu hidden">
                            <button type="button" id="btnSaveDraft">Save draft</button>
                            <button type="button" id="btnPublish">Publish</button>
                        </div>
                    </div>
                    <div class="flow-dropdown" id="overflowDropdown">
                        <button type="button" id="btnOverflowMenu" class="flow-topbar-btn flow-topbar-btn-icon" title="More" aria-expanded="false" aria-controls="flowOverflowMenu" aria-label="More">⋯</button>
                        <div id="flowOverflowMenu" class="flow-dropdown-menu flow-dropdown-menu-end hidden">
                            <label class="flow-toggle" id="flowEnabledLabel">
                                <input type="checkbox" id="flowEnabled">
                                <span>Flow engine enabled</span>
                                <span id="flowEnabledOverride" class="flow-toggle-note hidden"></span>
                            </label>
                            <button type="button" id="btnGlobalStrings">Global Strings 🌐</button>
                            <label class="flow-entry-picker">
                                Entry node
                                <select id="entryKeySelect" aria-label="Flow entry node"></select>
                            </label>
                        </div>
                    </div>
                </div>
            </header>

            <div class="flow-layout">
                <aside class="flow-palette" aria-label="Block palette">
                    <p class="flow-palette-heading">Blocks</p>
                    <button type="button" id="btnAddMessageNode" class="flow-palette-item" title="Drag onto the canvas, or click to add at the centre" data-kind="message" draggable="true">
                        <span class="flow-palette-swatch message" aria-hidden="true"></span>
                        <span class="flow-palette-label">Message</span>
                    </button>
                    <button type="button" id="btnAddActionNode" class="flow-palette-item" title="Drag onto the canvas, or click to add at the centre" data-kind="action" draggable="true">
                        <span class="flow-palette-swatch action" aria-hidden="true"></span>
                        <span class="flow-palette-label">Action</span>
                    </button>
                    <p class="flow-palette-hint">Drag onto the canvas, or click to add at the centre</p>
                </aside>
                <div class="flow-canvas-wrap">
                    <div id="drawflow" class="flow-canvas"></div>
                    <div id="selectionToolbar" class="flow-selection-toolbar" hidden role="toolbar" aria-label="Selected block actions">
                        <button type="button" id="btnDuplicateNode" title="Duplicate (Ctrl/Cmd+D)">Duplicate</button>
                        <button type="button" id="btnCopyNode" title="Copy (Ctrl/Cmd+C)">Copy</button>
                        <button type="button" id="btnToolbarDeleteNode" title="Delete (Delete)">Delete</button>
                    </div>
                    <div class="flow-canvas-controls" aria-label="Canvas zoom">
                        <button type="button" id="btnZoomIn" title="Zoom In">+</button>
                        <button type="button" id="btnZoomOut" title="Zoom Out">−</button>
                        <button type="button" id="btnFitView" title="Reset Zoom">⛶</button>
                    </div>
                </div>
                <aside id="flowPanel" class="flow-panel" aria-label="Node editor">
                    <div class="flow-panel-empty">
                        <strong>Inspector</strong>
                        Loading flow…
                    </div>
                </aside>
            </div>
        </div>

        <div id="previewModal" class="preview-modal hidden" role="dialog" aria-modal="true" aria-labelledby="previewTitle">
            <div class="preview-backdrop" id="previewBackdrop"></div>
            <div class="phone-frame">
                <div class="phone-header">
                    <span id="previewTitle">Preview</span>
                    <button type="button" id="previewClose" class="phone-close" aria-label="Close preview">×</button>
                </div>
                <div id="previewMedia" class="phone-media hidden"></div>
                <div id="previewCaption" class="phone-caption"></div>
                <div id="previewKeyboard" class="phone-keyboard"></div>
            </div>
        </div>

        <div id="globalStringsModal" class="global-strings-modal hidden" role="dialog" aria-modal="true" aria-labelledby="globalStringsTitle">
            <div class="global-strings-backdrop" id="globalStringsBackdrop"></div>
            <div class="global-strings-drawer">
                <div class="global-strings-header">
                    <h3 id="globalStringsTitle">Global Strings (Non-Graph Copy)</h3>
                    <button type="button" id="globalStringsClose" class="global-strings-close" aria-label="Close global strings">×</button>
                </div>
                <div class="global-strings-toolbar">
                    <input type="text" id="globalStringsSearch" placeholder="Search keys (e.g. err.*, msg.*)..." aria-label="Search global string keys">
                </div>
                <div class="global-strings-body" id="globalStringsList">
                    <p class="muted">Loading global strings...</p>
                </div>
                <div class="global-strings-footer">
                    <button type="button" id="btnSaveGlobalStrings" class="btn btn-primary">Save Global Strings</button>
                </div>
            </div>
        </div>
    </main>
    <%- include('partials/mobile-tabs') %>
    <script src="/vendor/drawflow/drawflow.min.js"></script>
    <script src="/js/flow-builder/state.js"></script>
    <script src="/js/flow-builder/commands.js"></script>
    <script src="/js/flow-builder/clipboard.js"></script>
    <script src="/js/flow-builder/palette.js"></script>
    <script src="/js/flow-builder/validation.js"></script>
    <script src="/js/flow-builder.js"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head') %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/jerosoler/Drawflow/dist/drawflow.min.css">
    <link rel="stylesheet" href="/css/flow-builder.css">
</head>
<body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <%- include('partials/sidebar') %>
    <main class="main-content" id="main-content">
        <%- include('partials/topbar') %>

        <div class="flow-toolbar">
            <label class="flow-toggle">
                <input type="checkbox" id="flowEnabled">
                <span>Flow engine enabled</span>
            </label>
            <div class="flow-toolbar-actions">
                <button type="button" id="btnSaveDraft" class="btn btn-secondary">Save draft</button>
                <button type="button" id="btnPreview" class="btn">Preview</button>
                <button type="button" id="btnPublish" class="btn btn-primary">Publish</button>
            </div>
            <span id="flowStatus" class="flow-status" aria-live="polite"></span>
        </div>

        <p id="flowMeta" class="flow-meta muted"></p>

        <div class="flow-layout">
            <div id="drawflow" class="flow-canvas"></div>
            <aside id="flowPanel" class="flow-panel" aria-label="Node editor">
                <div class="flow-panel-empty">
                    <strong>Edit panel</strong>
                    Loading flow…
                </div>
            </aside>
        </div>

        <div id="previewModal" class="preview-modal hidden" role="dialog" aria-modal="true" aria-labelledby="previewTitle">
            <div class="preview-backdrop" id="previewBackdrop"></div>
            <div class="phone-frame">
                <div class="phone-header">
                    <span id="previewTitle">Preview</span>
                    <button type="button" id="previewClose" class="phone-close" aria-label="Close preview">×</button>
                </div>
                <div id="previewCaption" class="phone-caption"></div>
                <div id="previewKeyboard" class="phone-keyboard"></div>
            </div>
        </div>
    </main>
    <%- include('partials/mobile-tabs') %>
    <script src="https://cdn.jsdelivr.net/gh/jerosoler/Drawflow/dist/drawflow.min.js"></script>
    <script src="/js/flow-builder.js"></script>
</body>
</html>

<%
    const currentPage = 'produk';
    const pageTitle = '➕ Tambah Produk';
    const kategoriList = [
        ['umum', '📦 Umum'],
        ['game', '🎮 Game'],
        ['streaming', '📺 Streaming'],
        ['software', '💻 Software'],
        ['social media', '📱 Social Media'],
        ['voucher', '🎟️ Voucher'],
        ['education', '📚 Education']
    ];
    const kategoriTerpilih = (produk && produk.kategori ? produk.kategori : 'umum').toLowerCase();
%>
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/dashboard.css">
    <script src="/js/ui-utils.js"></script>
</head>
<body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    
    <%- include('partials/sidebar') %>
    
    <main class="main-content" id="main-content">
        <div class="top-bar">
            <div class="top-bar-left">
                <button class="sidebar-toggle" onclick="toggleSidebar()" aria-label="Toggle sidebar">☰</button>
                <h1 style="font-size: 24px; color: #333; margin: 0;"><%= pageTitle %></h1>
            </div>
            <div class="top-bar-right">
                <div class="user-info">
                    <span>👤 <%= username || 'Admin' %></span>
                    <% if (req.session.role) { %>
                        <span class="user-badge"><%= req.session.role %></span>
                    <% } %>
                </div>
                <a href="/produk" class="btn-top">← Kembali</a>
                <a href="/admin/change-password" class="btn-top">🔐 Ubah Password</a>
                <a href="/logout" class="btn-top btn-logout">Logout</a>
            </div>
        </div>
        
        <div class="container">
            <% if (error) { %>
                <div class="alert alert-error" style="margin-bottom:16px;">❌ <%= error %></div>
            <% } %>
            <div class="form-container">
                <div class="card">
                    <div class="card-header">
                        <h2 class="card-title">Tambah Produk Baru</h2>
                    </div>
                    <div class="card-body">
                        <form method="POST" action="/produk/tambah" data-loading>
                            <h3 style="margin:0 0 16px;font-size:16px;color:#333;">Informasi Produk</h3>
                            <div class="form-group">
                                <label class="form-label">Nama Produk <span class="required">*</span></label>
                                <input type="text" name="nama" class="form-input" value="<%= produk ? produk.nama : '' %>" required placeholder="Contoh: Netflix Premium">
                            </div>
                            <div class="form-group">
                                <label class="form-label">Kategori</label>
                                <select name="kategori" class="form-input">
                                    <% kategoriList.forEach(([nilai, label]) => { %>
                                        <option value="<%= nilai %>" <%= kategoriTerpilih === nilai ? 'selected' : '' %>><%= label %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Deskripsi <span class="required">*</span></label>
                                <textarea name="deskripsi" class="form-textarea" rows="4" required placeholder="Deskripsi produk"><%= produk ? produk.deskripsi : '' %></textarea>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Syarat & Ketentuan <span class="required">*</span></label>
                                <textarea name="snk" class="form-textarea" rows="4" required placeholder="Syarat dan ketentuan"><%= produk ? produk.snk : '' %></textarea>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Banner URL</label>
                                <input type="url" name="banner_url" class="form-input" value="<%= produk ? (produk.banner_url || '') : '' %>" placeholder="https://...">
                            </div>

                            <h3 style="margin:24px 0 16px;font-size:16px;color:#333;padding-top:16px;border-top:1px solid #eee;">Varian Awal</h3>
                            <div class="form-group">
                                <label class="form-label">Label Varian</label>
                                <input type="text" name="varian_label" class="form-input" value="<%= produk ? (produk.varian_label || 'Default') : 'Default' %>" placeholder="Contoh: 1 Bulan">
                            </div>
                            <div class="form-group">
                                <label class="form-label">Kode Varian <span class="required">*</span></label>
                                <input type="text" name="varian_kode" class="form-input" value="<%= produk ? produk.varian_kode : '' %>" required pattern="[a-z0-9-]+" placeholder="netflix-1bulan">
                                <div class="form-help">Kode unik untuk pembelian — huruf kecil, angka, dan tanda hubung.</div>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Harga (Rp) <span class="required">*</span></label>
                                <input type="number" name="harga" class="form-input" value="<%= produk ? produk.harga : '' %>" required min="0" placeholder="25000">
                            </div>
                            <div class="form-group">
                                <label class="form-label">Format Produk (Opsional)</label>
                                <input type="text" name="format" class="form-input" value="<%= produk ? (produk.format || '') : '' %>" placeholder="Email:Password">
                            </div>

                            <div class="form-actions">
                                <button type="submit" class="btn btn-primary">💾 Simpan Produk</button>
                                <a href="/produk" class="btn" style="background: #6c757d;">❌ Batal</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main>
    
    <div class="quick-actions">
        <button class="quick-action-btn" onclick="window.scrollTo({top: 0, behavior: 'smooth'})" aria-label="Scroll to top">↑</button>
    </div>
    
    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('collapsed');
            sidebar.classList.toggle('open');
        }
        document.querySelector('form').addEventListener('submit', (e) => {
            if (!FormValidator.validate(e.target)) e.preventDefault();
        });
    </script>
    <script src="/js/notifications.js"></script>
</body>
</html>

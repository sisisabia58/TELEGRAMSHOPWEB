<%
    breadcrumbs = [
        { label: 'Home', href: '/' },
        { label: 'Customers', href: '/user' },
        { label: 'Deposits' }
    ];
%>
<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head') %>
    <style>
        .metric-tile .value.pending { color: var(--color-warning); }
        .metric-tile .value.success { color: var(--color-success); }
        .metric-tile .value.failed { color: var(--color-danger); }
        .metric-tile .value.expired { color: var(--color-muted); }
        .metric-tile .sub { font-size: 12px; color: var(--color-muted); margin-top: 4px; }
        .deposit-toolbar-form {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 10px;
            width: 100%;
        }
        .deposit-toolbar-form .filter-group {
            min-width: 120px;
        }
        .deposit-toolbar-form .form-label {
            font-size: 11px;
            margin-bottom: 4px;
        }
        .deposit-row-actions {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }
        .deposit-approve-reject {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
        }
        .deposit-approve-reject form {
            display: inline;
        }
        .deposit-action-btn {
            width: 36px;
            height: 36px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            font-size: 16px;
            background: transparent;
            padding: 0;
            line-height: 1;
            transition: all 0.2s;
        }
        .deposit-action-btn:hover {
            transform: scale(1.1);
            background: var(--color-surface-muted);
        }
        .deposit-action-approve { color: var(--color-success); }
        .deposit-action-reject { color: var(--color-danger); }
        .deposit-action-label { display: none; }
        @media (max-width: 640px) {
            .mobile-card-actions .deposit-approve-reject {
                flex-direction: column;
                width: 100%;
            }
            .mobile-card-actions .deposit-approve-reject form {
                display: block;
                width: 100%;
            }
            .mobile-card-actions .deposit-action-btn {
                width: 100%;
                min-height: 44px;
                padding: 10px 16px;
                font-size: 14px;
                font-weight: 600;
                border-radius: var(--radius);
                transform: none;
            }
            .mobile-card-actions .deposit-action-btn:hover {
                transform: none;
            }
            .mobile-card-actions .deposit-action-approve {
                background: var(--color-success);
                color: #fff;
            }
            .mobile-card-actions .deposit-action-reject {
                background: var(--color-danger);
                color: #fff;
            }
            .mobile-card-actions .deposit-action-label { display: inline; }
            .mobile-card-actions .deposit-row-actions {
                flex-direction: column;
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    
    <%- include('partials/sidebar') %>
    
    <main class="main-content" id="main-content">
        <%- include('partials/topbar') %>
        
        <div class="container">
            <%- include('partials/page-header', { breadcrumbs: breadcrumbs, pageHeaderActions: '' }) %>

            <div class="metric-strip">
                <div class="metric-tile">
                    <div class="label">Total Deposit</div>
                    <div class="value"><%= stats.total %></div>
                </div>
                <div class="metric-tile">
                    <div class="label">Pending</div>
                    <div class="value pending"><%= stats.pending %></div>
                    <div class="sub"><%= formatrupiah(stats.totalPending) %></div>
                </div>
                <div class="metric-tile">
                    <div class="label">Success</div>
                    <div class="value success"><%= stats.success %></div>
                    <div class="sub"><%= formatrupiah(stats.totalSuccess) %></div>
                </div>
                <div class="metric-tile">
                    <div class="label">Failed</div>
                    <div class="value failed"><%= stats.failed %></div>
                </div>
                <div class="metric-tile">
                    <div class="label">Expired</div>
                    <div class="value expired"><%= stats.expired %></div>
                </div>
            </div>

            <div class="toolbar">
                <form method="GET" action="/deposit" class="deposit-toolbar-form">
                    <div class="filter-group">
                        <label class="form-label">Status</label>
                        <select name="status" class="form-select">
                            <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>Semua</option>
                            <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
                            <option value="success" <%= filters.status === 'success' ? 'selected' : '' %>>Success</option>
                            <option value="failed" <%= filters.status === 'failed' ? 'selected' : '' %>>Failed</option>
                            <option value="expired" <%= filters.status === 'expired' ? 'selected' : '' %>>Expired</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label class="form-label">Metode</label>
                        <select name="metode" class="form-select">
                            <option value="all" <%= filters.metode === 'all' ? 'selected' : '' %>>Semua</option>
                            <option value="qris" <%= filters.metode === 'qris' ? 'selected' : '' %>>QRIS</option>
                            <option value="manual" <%= filters.metode === 'manual' ? 'selected' : '' %>>Manual</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label class="form-label">Tanggal Mulai</label>
                        <input type="date" name="startDate" class="form-input" value="<%= filters.startDate || '' %>">
                    </div>
                    <div class="filter-group">
                        <label class="form-label">Tanggal Akhir</label>
                        <input type="date" name="endDate" class="form-input" value="<%= filters.endDate || '' %>">
                    </div>
                    <div class="filter-group">
                        <label class="form-label">User ID</label>
                        <input type="number" name="user" class="form-input" placeholder="User ID" value="<%= filters.user || '' %>">
                    </div>
                    <div class="filter-group">
                        <label class="form-label">Search</label>
                        <input type="text" name="search" class="form-input" placeholder="Kode Deposit atau User ID" value="<%= filters.search || '' %>">
                    </div>
                    <div class="toolbar-spacer"></div>
                    <button type="submit" class="btn btn-primary">Filter</button>
                    <a href="/deposit" class="btn btn-secondary">Reset</a>
                </form>
            </div>

            <!-- Pagination -->
            <div class="pagination">
                <% if (currentPageNum > 1) { %>
                    <% 
                        const prevParams = []
                        if (filters.status && filters.status !== 'all') prevParams.push('status=' + filters.status)
                        if (filters.startDate) prevParams.push('startDate=' + filters.startDate)
                        if (filters.endDate) prevParams.push('endDate=' + filters.endDate)
                        if (filters.user) prevParams.push('user=' + filters.user)
                        if (filters.metode && filters.metode !== 'all') prevParams.push('metode=' + filters.metode)
                        if (filters.search) prevParams.push('search=' + encodeURIComponent(filters.search))
                        prevParams.push('page=' + (currentPageNum - 1))
                        const prevQuery = prevParams.length > 0 ? '?' + prevParams.join('&') : '?page=' + (currentPageNum - 1)
                    %>
                    <a href="<%= prevQuery %>" class="pagination-btn">← Sebelumnya</a>
                <% } else { %>
                    <span class="pagination-btn" style="opacity: 0.5; cursor: not-allowed;">← Sebelumnya</span>
                <% } %>
                <span class="pagination-info">Halaman <%= currentPageNum %> dari <%= totalPages %></span>
                <% if (currentPageNum < totalPages) { %>
                    <% 
                        const nextParams = []
                        if (filters.status && filters.status !== 'all') nextParams.push('status=' + filters.status)
                        if (filters.startDate) nextParams.push('startDate=' + filters.startDate)
                        if (filters.endDate) nextParams.push('endDate=' + filters.endDate)
                        if (filters.user) nextParams.push('user=' + filters.user)
                        if (filters.metode && filters.metode !== 'all') nextParams.push('metode=' + filters.metode)
                        if (filters.search) nextParams.push('search=' + encodeURIComponent(filters.search))
                        nextParams.push('page=' + (currentPageNum + 1))
                        const nextQuery = nextParams.length > 0 ? '?' + nextParams.join('&') : '?page=' + (currentPageNum + 1)
                    %>
                    <a href="<%= nextQuery %>" class="pagination-btn">Selanjutnya →</a>
                <% } else { %>
                    <span class="pagination-btn" style="opacity: 0.5; cursor: not-allowed;">Selanjutnya →</span>
                <% } %>
            </div>

            <!-- Deposits Table -->
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">Daftar Deposit</h2>
                </div>
                <div class="card-body">
                    <div class="table-wrapper">
                        <table>
                            <thead>
                                <tr>
                                    <th>Tanggal</th>
                                    <th>User ID</th>
                                    <th>Kode Deposit</th>
                                    <th>Jumlah</th>
                                    <th>Fee</th>
                                    <th>Total</th>
                                    <th>Status</th>
                                    <th>Metode</th>
                                    <th>Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (deposits.length === 0) { %>
                                    <tr>
                                        <td colspan="9">
                                            <div class="empty-state">
                                                <div class="empty-state-icon">💰</div>
                                                <div class="empty-state-title">Belum ada deposit</div>
                                                <div class="empty-state-description">Deposit akan muncul di sini setelah user melakukan deposit</div>
                                            </div>
                                        </td>
                                    </tr>
                                <% } else { %>
                                    <% deposits.forEach(d => { %>
                                        <tr>
                                            <td><%= formatTanggal(d.tanggal) %></td>
                                            <td><code><%= d.user_id %></code></td>
                                            <td><code><%= d.kode_deposit %></code></td>
                                            <td><%= formatrupiah(d.jumlah) %></td>
                                            <td><%= formatrupiah(d.fee) %></td>
                                            <td><strong><%= formatrupiah(d.total) %></strong></td>
                                            <td>
                                                <% if (d.status === 'pending') { %>
                                                    <span class="badge badge-warning">⏳ Pending</span>
                                                <% } else if (d.status === 'success') { %>
                                                    <span class="badge badge-success">✅ Success</span>
                                                <% } else if (d.status === 'failed') { %>
                                                    <span class="badge badge-danger">❌ Failed</span>
                                                <% } else { %>
                                                    <span class="badge badge-info">⏰ Expired</span>
                                                <% } %>
                                            </td>
                                            <td><%= d.metode === 'qris' ? '💳 QRIS' : '👤 Manual' %></td>
                                            <td>
                                                <div class="table-actions deposit-row-actions">
                                                    <a href="/deposit/<%= d.id %>" class="btn-icon" title="Detail"><svg class="icon" aria-hidden="true"><use href="#i-eye"></use></svg></a>
                                                    <% if (d.status === 'pending') { %>
                                                        <div class="deposit-approve-reject">
                                                            <form method="POST" action="/deposit/<%= d.id %>/approve" onsubmit="return confirm('Yakin approve deposit ini?')">
                                                                <button type="submit" class="deposit-action-btn deposit-action-approve" title="Approve"><svg class="icon" aria-hidden="true"><use href="#i-check"></use></svg><span class="deposit-action-label"> Approve</span></button>
                                                            </form>
                                                            <form method="POST" action="/deposit/<%= d.id %>/reject" onsubmit="return confirm('Yakin reject deposit ini?')">
                                                                <button type="submit" class="deposit-action-btn deposit-action-reject" title="Reject"><svg class="icon" aria-hidden="true"><use href="#i-x"></use></svg><span class="deposit-action-label"> Reject</span></button>
                                                            </form>
                                                        </div>
                                                    <% } %>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <%- include('partials/mobile-tabs') %>
    
    <div class="quick-actions">
        <button class="quick-action-btn" onclick="window.scrollTo({top: 0, behavior: 'smooth'})" aria-label="Scroll to top" title="Scroll to top">
            ↑
        </button>
    </div>
    
    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('collapsed');
            sidebar.classList.toggle('open');
        }
        
        document.addEventListener('click', (e) => {
            const sidebar = document.getElementById('sidebar');
            const toggleBtn = document.querySelector('.sidebar-toggle');
            
            if (window.innerWidth <= 768 && 
                sidebar.classList.contains('open') && 
                !sidebar.contains(e.target) && 
                !toggleBtn.contains(e.target)) {
                sidebar.classList.remove('open');
            }
        });
        
        window.addEventListener('resize', () => {
            const sidebar = document.getElementById('sidebar');
            if (window.innerWidth > 768) {
                sidebar.classList.remove('open');
            }
        });
        
        document.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const success = urlParams.get('success');
            const error = urlParams.get('error');
            
            if (success) {
                const messages = {
                    'approve': 'Deposit berhasil di-approve!',
                    'reject': 'Deposit berhasil di-reject!'
                };
                toast.success(messages[success] || 'Operasi berhasil!', 'Berhasil');
            }
            if (error) {
                const messages = {
                    'notfound': 'Deposit tidak ditemukan!',
                    'alreadyprocessed': 'Deposit sudah diproses sebelumnya!'
                };
                toast.error(messages[error] || 'Terjadi kesalahan!', 'Error');
            }
        });
    </script>
    
</body>
</html>

<%
    const currentPage = 'communication';
    const pageTitle = '📝 Message Templates';
%>
<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head') %>
</head>
<body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <%- include('partials/sidebar') %>
    <main class="main-content" id="main-content">
        <%
            const topbarExtra = `<a href="/communication/templates/tambah" class="btn btn-success">➕ Tambah Template</a> <a href="/communication/broadcast" class="btn-top">📢 Broadcast</a> <a href="/communication/send" class="btn-top">✉️ Send</a> <a href="/communication/history" class="btn-top">📜 History</a>`
        %>
        <%- include('partials/topbar') %>
        <div class="container">
            <% if (success === 'tambah') { %>
            <div class="alert alert-success">✅ Template berhasil ditambahkan!</div>
            <% } else if (success === 'edit') { %>
            <div class="alert alert-success">✅ Template berhasil diupdate!</div>
            <% } else if (success === 'hapus') { %>
            <div class="alert alert-success">✅ Template berhasil dihapus!</div>
            <% } %>

            <% if (error) { %>
            <div class="alert alert-error">❌ Error: <%= error %></div>
            <% } %>

            <div class="table-container">
            <table>
            <thead>
            <tr>
            <th>Nama</th>
            <th>Kategori</th>
            <th>Subject</th>
            <th>Variabel</th>
            <th>Status</th>
            <th>Created</th>
            <th>Aksi</th>
            </tr>
            </thead>
            <tbody>
            <% if (templates.length === 0) { %>
            <tr>
            <td colspan="7" class="text-center">Belum ada template. <a href="/communication/templates/tambah">Tambah template baru</a></td>
            </tr>
            <% } else { %>
            <% templates.forEach(t => { %>
            <tr>
            <td><strong><%= t.name %></strong></td>
            <td>
            <span style="padding: 4px 8px; background: #17a2b8; color: white; border-radius: 4px; font-size: 12px;">
            <%= t.category %>
            </span>
            </td>
            <td><%= t.subject || '-' %></td>
            <td>
            <% if (t.variables && Array.isArray(t.variables) && t.variables.length > 0) { %>
            <code style="font-size: 11px;"><%= t.variables.join(', ') %></code>
            <% } else { %>
            <span style="color: #999;">-</span>
            <% } %>
            </td>
            <td>
            <% if (t.is_active) { %>
            <span style="color: #28a745;">✅ Aktif</span>
            <% } else { %>
            <span style="color: #dc3545;">❌ Nonaktif</span>
            <% } %>
            </td>
            <td><%= formatTanggal(t.created_at) %></td>
            <td>
            <a href="/communication/templates/edit/<%= t.id %>" style="padding: 5px 10px; background: #17a2b8; color: white; text-decoration: none; border-radius: 4px; font-size: 12px; margin-right: 5px;">
            ✏️ Edit
            </a>
            <form method="POST" action="/communication/templates/hapus/<%= t.id %>" style="display: inline;" onsubmit="return confirm('Yakin ingin menghapus template ini?')">
            <button type="submit" style="padding: 5px 10px; background: #dc3545; color: white; border: none; border-radius: 4px; font-size: 12px; cursor: pointer;">
            🗑️ Hapus
            </button>
            </form>
            </td>
            </tr>
            <% }) %>
            <% } %>
            </tbody>
            </table>
            </div>
        </div>
    </main>
    <%- include('partials/mobile-tabs') %>
</body>
</html>

